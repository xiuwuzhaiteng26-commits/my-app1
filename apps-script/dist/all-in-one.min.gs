INLINE_HTML.Reconcile='<!DOCTYPE html> <html> <head> <base target="_top"> <style>body{font-family:-apple-system,\'Segoe UI\',\'Hiragino Sans\',\'Noto Sans JP\',sans-serif;font-size:14px;color:#222;margin:16px}h2{font-size:16px;margin:0 0 12px}label{display:block;margin:12px 0 4px;font-weight:700}input,select,textarea{width:100%;box-sizing:border-box;padding:6px 8px;border:1px solid #ccc;border-radius:4px;font-size:14px}.estimate{background:#eceff1;padding:10px;border-radius:4px;margin-top:12px}.estimate strong{font-size:18px}button{margin-top:16px;padding:8px 16px;font-size:14px;border:0;border-radius:4px;background:#1a73e8;color:#fff;cursor:pointer}button:disabled{background:#9e9e9e;cursor:default}#result{margin-top:14px;padding:10px;border-radius:4px;display:none;white-space:pre-wrap}.ok{background:#e8f5e9;color:#1b5e20}.ng{background:#fff3e0;color:#bf360c}.disclaimer{margin-top:18px;font-size:11px;color:#666;border-top:1px solid #ddd;padding-top:10px}</style> </head> <body> <h2>月次の答え合わせ</h2> <p style="margin:0;color:#555">給与明細・支給照会の合計額（額面）を入力してください。</p> <label for="month">対象月</label> <select id="month"></select> <label for="company">勤務先</label> <select id="company"></select> <div class="estimate"> カレンダーからの推定額（額面）<br> <strong id="estimate">-</strong> </div> <label for="actual">実際の支給額（額面・円）</label> <input id="actual" type="number" inputmode="numeric" step="1" placeholder="例: 98000"> <label for="note">メモ（任意）</label> <textarea id="note" rows="2" placeholder="交通費込み など"></textarea> <button id="save" disabled="disabled">保存して差分を確認</button> <div id="result"></div> <div class="disclaimer" id="disclaimer"></div> <script>var DATA=null;function yen(e){return Math.round(e).toString().replace(/\\B(?=(\\d{3})+(?!\\d))/g,",")+"円"}function fillSelect(e,t){e.innerHTML="";t.forEach(function(t){var n=document.createElement("option");n.value=t;n.textContent=t;e.appendChild(n)})}function updateEstimate(){if(!DATA)return;var e=document.getElementById("month").value+"\\t"+document.getElementById("company").value;var t=DATA.estimates[e];document.getElementById("estimate").textContent=t===undefined?"-":yen(t)}function onData(e){DATA=e;fillSelect(document.getElementById("month"),e.months);fillSelect(document.getElementById("company"),e.companies);document.getElementById("disclaimer").textContent=e.disclaimer;document.getElementById("save").disabled=false;updateEstimate()}function onSaved(e){var t=document.getElementById("result");t.style.display="block";t.className=e.status==="OK"?"ok":"ng";t.textContent="推定額 "+yen(e.estimated)+"\\n実額 "+yen(e.actual)+"\\n差分 "+yen(e.diff)+"\\n\\n"+e.message;document.getElementById("save").disabled=false;updateEstimate()}function onError(e){var t=document.getElementById("result");t.style.display="block";t.className="ng";t.textContent="エラー: "+e.message;document.getElementById("save").disabled=false}document.getElementById("month").addEventListener("change",updateEstimate);document.getElementById("company").addEventListener("change",updateEstimate);document.getElementById("save").addEventListener("click",function(){var e=document.getElementById("actual").value;if(e===""){onError({message:"実際の支給額を入力してください"});return}document.getElementById("save").disabled=true;google.script.run.withSuccessHandler(onSaved).withFailureHandler(onError).saveReconciliation({yearMonth:document.getElementById("month").value,companyName:document.getElementById("company").value,actualAmount:e,note:document.getElementById("note").value})});google.script.run.withSuccessHandler(onData).withFailureHandler(onError).getReconcileFormData()<\/script> </body> </html> ';
